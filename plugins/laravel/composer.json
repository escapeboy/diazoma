{
    "name": "diazoma/laravel",
    "description": "Serve a Diazoma wall feed, manifest and optional /xr embed from a Laravel app.",
    "type": "library",
    "license": "Apache-2.0",
    "keywords": ["diazoma", "wall", "xr", "laravel"],
    "require": {
        "php": "^8.4",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/routing": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "illuminate/database": "^12.0|^13.0",
        "illuminate/contracts": "^12.0|^13.0"
    },
    "require-dev": {
        "laravel/pint": "^1.18",
        "opis/json-schema": "^2.6",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Diazoma\\Laravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Diazoma\\Laravel\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Diazoma\\Laravel\\DiazomaServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "pest",
        "lint": "pint --test"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
